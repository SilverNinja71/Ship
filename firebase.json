{
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Ship Pwedo Pomo",
        "supportEmail": "support@ship-pwedo-pomo.firebaseapp.com",
        "authorizedRedirectUris": [
          "https://ship-pwedo-pomo.firebaseapp.com/__/auth/handler",
          "https://ship-pwedo-pomo.web.app/__/auth/handler",
          "http://localhost:5173"
        ]
      }
    }
  },
  "hosting": {
    "public": "apps/web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
